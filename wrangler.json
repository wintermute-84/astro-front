{
	"name": "astro-front-production",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"account_id": "90f1e06ea9720912eb57d684bc61f396",
	"upload_source_maps": true,
	"route": { "pattern": "3dreamlab.com", "custom_domain": true },
	"ratelimits": [
		{ "name": "DASHBOARD_AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
		{ "name": "DEMO_IP_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
	],
	"services": [{ "binding": "EDGE_CACHE", "service": "edge-cache", "entrypoint": "EdgeCacheRPC" }],
	"env": {
		"dev": {
			"name": "astro-front-dev",
			"account_id": "90f1e06ea9720912eb57d684bc61f396",
			"route": { "pattern": "astro-front.vlad-kupriyenko.workers.dev", "custom_domain": true }
		}
	}
}
