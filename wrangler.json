{
	"name": "astro-front-production",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": ["/", "/fi", "/fi/", "/sv", "/sv/", "/store*", "/fi/store*", "/sv/store*"]
	},
	"observability": {
		"enabled": true
	},
	"account_id": "90f1e06ea9720912eb57d684bc61f396",
	"upload_source_maps": true,
	"routes": [
		{ "pattern": "3dreamlab.com", "custom_domain": true },
		{ "pattern": "store.3dreamlab.com", "custom_domain": true }
	],
	"ratelimits": [
		{ "name": "DASHBOARD_AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
		{ "name": "DEMO_IP_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
		{ "name": "OTP_IP_LIMITER", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } }
	],
	"d1_databases": [
		{ "binding": "SITE_DB", "database_name": "site", "database_id": "49c6ea2d-c75d-433c-936f-d3b857b3d952", "migrations_dir": "migrations" }
	],
	"services": [
		{ "binding": "EDGE_CACHE", "service": "edge-cache", "entrypoint": "EdgeCacheRPC" },
		{ "binding": "EDGE_CUSTOMER", "service": "edge-cache", "entrypoint": "EdgeCustomerRPC" }
	],
	"env": {
		"dev": {
			"name": "astro-front-dev",
			"account_id": "90f1e06ea9720912eb57d684bc61f396",
			"route": { "pattern": "astro-front.vlad-kupriyenko.workers.dev", "custom_domain": true }
		}
	}
}
