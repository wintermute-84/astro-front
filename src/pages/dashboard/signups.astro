---
// Owner: preview requests → allowlist. Behind Cloudflare Access like all of /dashboard.
import { env } from 'cloudflare:workers';
import Layout from '../../components/dashboard/Layout.astro';
import { rpc, setFlash } from '../../lib/dashboard/edge';
import { PLAN_IDS, approveRequest, isPlan, listAllowlist, listSignupRequests, rejectRequest } from '../../lib/app/signup';
import { approvedMail, sendMail } from '../../lib/app/mail';
import { nowS, siteDb } from '../../lib/app/site';

export const prerender = false;

const db = siteDb();
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action'));
  const id = String(fd.get('id') ?? '');
  const now = nowS();
  if (action === 'approve') {
    const plan = String(fd.get('plan'));
    const email = isPlan(plan) ? await approveRequest(db, id, plan, now) : null;
    if (email) {
      const sent = await sendMail(db, env, approvedMail(email, Astro.url.origin), now);
      setFlash(Astro.cookies, sent ? { kind: 'ok', message: `Approved ${email} on ${plan}; "you're in" email sent.` } : { kind: 'err', message: `Approved ${email} on ${plan}, but the email was not sent (key, cap or Resend error). Tell them yourself.` });
    } else setFlash(Astro.cookies, { kind: 'err', message: 'Request not found or already decided.' });
  } else if (action === 'reject') {
    const ok = await rejectRequest(db, id, now);
    setFlash(Astro.cookies, ok ? { kind: 'ok', message: 'Rejected. No email sent.' } : { kind: 'err', message: 'Request not found or already decided.' });
  } else if (action === 'plan') {
    const slug = String(fd.get('slug') ?? '');
    const plan = String(fd.get('plan'));
    const raw = String(fd.get('dailyLimit') ?? '').trim();
    const r = isPlan(plan) ? await rpc((api) => api.setPlan(slug, plan, raw === '' ? null : Number(raw))) : null;
    setFlash(Astro.cookies, r?.ok ? { kind: 'ok', message: `${slug}: plan ${plan}, ${r.data.dailyLimit.toLocaleString('en')} requests/day.` } : { kind: 'err', message: `Plan not changed: ${r ? (r.ok ? '' : r.error) : 'bad plan'}` });
  } else if (action === 'status') {
    const slug = String(fd.get('slug') ?? '');
    const status = fd.get('status') === 'suspended' ? 'suspended' : 'active';
    const r = await rpc((api) => api.setStatus(slug, status));
    setFlash(Astro.cookies, r.ok ? { kind: 'ok', message: `${slug} is now ${r.data.status}.` } : { kind: 'err', message: `Status not changed: ${r.error}` });
  } else if (action === 'revoke') {
    const email = String(fd.get('email') ?? '');
    await db.prepare('DELETE FROM preview_allowlist WHERE email = ?').bind(email).run();
    setFlash(Astro.cookies, { kind: 'ok', message: `Removed ${email} from the allowlist; their sessions stop working now. Their projects stay until you suspend or they delete them.` });
  }
  return Astro.redirect('/dashboard/signups', 303);
}

const requests = await listSignupRequests(db);
const pending = requests.filter((r) => r.status === 'pending');
const decided = requests.filter((r) => r.status !== 'pending').slice(0, 30);
const allow = await listAllowlist(db);
const tenants = await rpc((api) => api.listTenants());
const customers = tenants.ok ? tenants.data.filter((t) => t.kind === 'customer') : [];
const when = (s: number) => new Date(s * 1000).toISOString().slice(0, 16).replace('T', ' ');
---

<Layout title="Sign-ups" crumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Sign-ups' }]}>
  <div class="page-head">
    <div>
      <h1 class="page-title">SIGN-UPS</h1>
      <p class="page-sub">Preview requests from /signup. Approve = allowlist + "you're in" email. Paid tiers: invoice first, then pick the plan.</p>
    </div>
  </div>

  <section class="card">
    <div class="card__head"><h2 class="label card__title">Pending · {pending.length}</h2></div>
    {pending.length === 0 && <div class="empty"><p>No pending requests.</p></div>}
    {
      pending.length > 0 && (
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th scope="col">Requested</th><th scope="col">Email</th><th scope="col">Tier</th><th scope="col">Company · note</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
            </thead>
            <tbody>
              {pending.map((r) => (
                <tr>
                  <td class="mono">{when(r.created_at)}</td>
                  <td class="mono">{r.email}</td>
                  <td class="mono">{r.plan}</td>
                  <td>{r.company ?? '—'}{r.note && <p class="dim" style="margin:.25rem 0 0;white-space:pre-wrap">{r.note}</p>}</td>
                  <td>
                    <form method="post" class="row-actions">
                      <input type="hidden" name="id" value={r.id} />
                      <label class="sr-only" for={`plan-${r.id}`}>Plan for {r.email}</label>
                      <select class="f__input mono" id={`plan-${r.id}`} name="plan">
                        {PLAN_IDS.map((p) => <option selected={p === r.plan}>{p}</option>)}
                      </select>
                      <button class="btn" name="_action" value="approve">Approve</button>
                      <button class="btn btn--outline" name="_action" value="reject">Reject</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section class="card">
    <div class="card__head"><h2 class="label card__title">Allowlist · {allow.length}</h2></div>
    {allow.length === 0 && <div class="empty"><p>Nobody approved yet.</p></div>}
    {
      allow.length > 0 && (
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th scope="col">Approved</th><th scope="col">Email</th><th scope="col">Plan</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
              {allow.map((a) => (
                <tr>
                  <td class="mono">{when(a.approved_at)}</td>
                  <td class="mono">{a.email}</td>
                  <td class="mono">{a.plan}</td>
                  <td>
                    <form method="post">
                      <input type="hidden" name="email" value={a.email} />
                      <button class="btn btn--outline" name="_action" value="revoke">Remove</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section class="card">
    <div class="card__head"><h2 class="label card__title">Customer projects · {customers.length}</h2></div>
    {!tenants.ok && <p class="mono"><b class="status--err">ERR</b> {tenants.error}</p>}
    {tenants.ok && customers.length === 0 && <div class="empty"><p>No customer projects yet.</p></div>}
    {
      customers.length > 0 && (
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th scope="col">Project</th><th scope="col">Status</th><th scope="col">Plan · limit</th><th scope="col">Upgrade asked</th><th scope="col">Set plan</th><th scope="col"><span class="sr-only">Status action</span></th></tr></thead>
            <tbody>
              {customers.map((t) => (
                <tr>
                  <td class="mono"><a class="link" href={`/dashboard/tenants/${t.slug}`}>{t.slug}</a></td>
                  <td class={`mono status--${t.status === 'active' ? 'ok' : t.status === 'suspended' ? 'err' : 'warn'}`}>{t.status.toUpperCase()}</td>
                  <td class="mono">{t.plan} · {t.dailyLimit.toLocaleString('en')}/day</td>
                  <td class="mono">{t.upgradeRequestedPlan ? <b class="status--warn">{t.upgradeRequestedPlan}</b> : '—'}</td>
                  <td>
                    <form method="post" class="row-actions">
                      <input type="hidden" name="slug" value={t.slug} />
                      <label class="sr-only" for={`p-${t.slug}`}>Plan for {t.slug}</label>
                      <select class="f__input mono" id={`p-${t.slug}`} name="plan">
                        {PLAN_IDS.map((p) => <option selected={p === (t.upgradeRequestedPlan ?? t.plan)}>{p}</option>)}
                      </select>
                      <label class="sr-only" for={`l-${t.slug}`}>Daily limit override for {t.slug}</label>
                      <input class="f__input mono" id={`l-${t.slug}`} name="dailyLimit" type="number" min="0" placeholder="plan default" style="width:9rem" />
                      <button class="btn" name="_action" value="plan">Set</button>
                    </form>
                  </td>
                  <td>
                    <form method="post">
                      <input type="hidden" name="slug" value={t.slug} />
                      <input type="hidden" name="status" value={t.status === 'suspended' ? 'active' : 'suspended'} />
                      <button class="btn btn--outline" name="_action" value="status">{t.status === 'suspended' ? 'Unsuspend' : 'Suspend'}</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  {
    decided.length > 0 && (
      <section class="card">
        <div class="card__head"><h2 class="label card__title">Decided (last 30)</h2></div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th scope="col">Decided</th><th scope="col">Email</th><th scope="col">Tier</th><th scope="col">Status</th></tr></thead>
            <tbody>
              {decided.map((r) => (
                <tr><td class="mono">{r.decided_at ? when(r.decided_at) : '—'}</td><td class="mono">{r.email}</td><td class="mono">{r.plan}</td><td class="mono">{r.status.toUpperCase()}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .row-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .row-actions select { width: auto; }
  .card + .card { margin-top: 1.5rem; }
</style>
