---
import { SITE_TITLE } from '../consts';
import { LOCALES, homePath, t, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const s = t(locale);
---

<nav class="nav" id="nav">
  <a href={homePath(locale)} class="nav__logo">{SITE_TITLE.toUpperCase()}</a>
  <div class="nav__right">
    <ul class="nav__langs" aria-label={s.lang_switch_label}>
      {LOCALES.map((l) => (
        <li>
          <a href={homePath(l)} hreflang={l} lang={l} class="nav__lang" aria-current={l === locale ? 'page' : undefined}>
            {l.toUpperCase()}
          </a>
        </li>
      ))}
    </ul>
    <a href="#contact" class="nav__link" data-offer="audit">{s.nav_cta}</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 5vw;
    font-family: var(--font-heading);
    font-size: var(--text-nav);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--black);
    background: transparent;
    transition: background 0.3s ease, color 0.3s ease, padding 0.3s ease, font-size 0.3s ease;
  }

  .nav--scrolled {
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
    font-size: 0.75rem;
    background: rgba(10, 10, 10, 0.72);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
    color: var(--white);
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav--scrolled {
      background: var(--black);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav__link { white-space: nowrap; }

  /* Phones can't fit logo + switcher + CTA: show the switcher at the top
     (the hero CTA is right below) and swap it for the CTA once compact. */
  @media (max-width: 600px) {
    .nav { gap: 1rem; }
    .nav__link { display: none; }
    .nav--scrolled .nav__link { display: inline-block; }
    .nav--scrolled .nav__langs { display: none; }
  }

  .nav__langs {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__lang {
    /* Same ~44px tap target trick as the CTA. */
    display: inline-block;
    padding: 0.9rem 0.15rem;
    margin: -0.9rem 0;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .nav__lang:hover,
  .nav__lang[aria-current] {
    opacity: 1;
  }

  .nav__lang[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .nav--scrolled .nav__link {
    font-size: inherit;
  }

  .nav__link {
    /* Keeps the tap target ~44px tall even when the bar is compact. */
    padding: 0.9rem 0;
    margin: -0.9rem 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--text-nav);
  }

  .nav__link:hover {
    opacity: 0.7;
  }
</style>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('nav--scrolled', window.scrollY > 100);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
