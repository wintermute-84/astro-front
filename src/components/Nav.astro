---
import { SITE_TITLE } from '../consts';
import { LOCALES, homePath, t, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const s = t(locale);
---

<nav class="nav" id="nav">
  <a href={homePath(locale)} class="nav__logo">{SITE_TITLE.toUpperCase()}</a>
  <div class="nav__right">
    <div class="nav__lang-switch" id="lang-switch">
      <button type="button" class="nav__globe" aria-expanded="false" aria-controls="nav-langs" aria-label={s.lang_switch_label}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="9.5" />
          <ellipse cx="12" cy="12" rx="4.2" ry="9.5" />
          <path d="M2.5 12h19M4 7h16M4 17h16" />
        </svg>
      </button>
      <ul class="nav__langs" id="nav-langs" inert>
        {LOCALES.map((l) => (
          <li>
            <a href={homePath(l)} hreflang={l} lang={l} class="nav__lang" aria-current={l === locale ? 'page' : undefined}>
              {l.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a href="#contact" class="nav__link" data-offer="audit">{s.nav_cta}</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 5vw;
    font-family: var(--font-heading);
    font-size: var(--text-nav);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--black);
    background: transparent;
    transition: background 0.3s ease, color 0.3s ease, padding 0.3s ease, font-size 0.3s ease;
  }

  .nav--scrolled {
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
    font-size: 0.75rem;
    background: rgba(10, 10, 10, 0.72);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
    color: var(--white);
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav--scrolled {
      background: var(--black);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav__lang-switch {
    display: flex;
    align-items: center;
  }

  .nav__globe {
    display: grid;
    place-items: center;
    /* ~44px tap target without growing the bar. */
    padding: 0.8rem;
    margin: -0.8rem -0.4rem -0.8rem -0.8rem;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    transition: transform 0.1s ease-out, opacity 0.2s;
  }

  .nav__globe:hover { opacity: 0.7; }
  .nav__globe:active { transform: scale(0.92); }
  .nav__globe svg { transition: transform 0.35s ease; }
  .nav__globe[aria-expanded='true'] svg { transform: rotate(-30deg); }

  /* Links slide out of the globe; clip-margin keeps their tall tap targets usable. */
  .nav__langs {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 0;
    opacity: 0;
    overflow: clip;
    overflow-clip-margin: 1rem;
    transform: translateX(-0.5rem);
    transition: max-width 0.35s ease, padding 0.35s ease, opacity 0.2s ease, transform 0.35s ease;
  }

  .nav__lang-switch.is-open .nav__langs {
    max-width: 12rem;
    padding-left: 0.75rem;
    opacity: 1;
    transform: none;
  }

  .nav__lang {
    display: inline-block;
    padding: 0.9rem 0.15rem;
    margin: -0.9rem 0;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .nav__lang:hover,
  .nav__lang[aria-current] {
    opacity: 1;
  }

  .nav__lang[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .nav__link {
    /* Keeps the tap target ~44px tall even when the bar is compact. */
    padding: 0.9rem 0;
    margin: -0.9rem 0;
    white-space: nowrap;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--text-nav);
  }

  .nav--scrolled .nav__link {
    font-size: inherit;
  }

  .nav__link:hover {
    opacity: 0.7;
  }

  /* Phones: the open switcher takes the CTA's place until it closes. */
  @media (max-width: 600px) {
    .nav__right:has(.is-open) .nav__link { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__langs,
    .nav__globe svg { transition: none; }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('nav--scrolled', window.scrollY > 100);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const sw = document.getElementById('lang-switch');
  const globe = sw?.querySelector('button');
  const langs = sw?.querySelector('ul');
  if (sw && globe && langs) {
    const setOpen = (open: boolean) => {
      sw.classList.toggle('is-open', open);
      globe.setAttribute('aria-expanded', String(open));
      langs.inert = !open;
    };
    globe.addEventListener('click', () => setOpen(!sw.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sw.classList.contains('is-open')) {
        setOpen(false);
        globe.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!sw.contains(e.target as Node)) setOpen(false);
    });
  }
</script>
