---
import { t, lines } from '../../i18n';

const s = t(Astro.currentLocale);
import SectionBg from '../SectionBg.astro';
---

<section class="section section--hero" id="hero">
  <SectionBg
    jpg="/LIGHT.jpg"
    webp="/LIGHT.webp"
    webpSm="/LIGHT-960.webp"
    width={1400}
    height={830}
    priority
  />
  <div class="section__overlay section__overlay--light"></div>
  <span class="section__meta">{s.hero_meta}</span>

  <div class="section__inner">
    <h1 class="heading-xl">
      {lines(s.hero_h).map((l, i, all) => (i === all.length - 1 ? <span class="accent">{l}</span> : <>{l}<br /></>))}
    </h1>
    <p class="body-text">
      <strong>{s.hero_lead_strong}</strong> {s.hero_lead}
    </p>
    <div class="actions">
      <a href="#contact" class="btn" data-offer="audit">{s.hero_btn}</a>
      <a href="#offers" class="link">{s.hero_link}</a>
    </div>
  </div>
</section>
