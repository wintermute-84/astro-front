---
import SectionBg from '../SectionBg.astro';
---

<section class="section section--hero" id="hero">
  <SectionBg
    jpg="/LIGHT.jpg"
    webp="/LIGHT.webp"
    webpSm="/LIGHT-960.webp"
    width={1400}
    height={830}
    priority
  />
  <div class="section__overlay section__overlay--light"></div>
  <span class="section__meta">speed · clarity · craft</span>
  <div class="section__inner">
    <h1 class="heading-xl reveal">
      FAST<br />
      <span class="heading-xl__commerce heading-xl__commerce--desktop">COMMERCE</span>
      <span class="heading-xl__commerce heading-xl__commerce--mobile">COMM<br />ERCE</span>
    </h1>
    <p class="body-text body-text--wide reveal">
      Lightning-fast e-commerce sites. Zero bloat. Built to convert.
    </p>
  </div>
</section>
