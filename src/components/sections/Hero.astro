---
import SectionBg from '../SectionBg.astro';
---

<section class="section section--hero" id="hero">
  <SectionBg
    jpg="/LIGHT.jpg"
    webp="/LIGHT.webp"
    webpSm="/LIGHT-960.webp"
    width={1400}
    height={830}
    priority
  />
  <div class="section__overlay section__overlay--light"></div>
  <span class="section__meta">agencies · b2b teams · finland + eu</span>

  <div class="section__inner">
    <h1 class="heading-xl reveal">
      SLOW API.<br />
      FAST EDGE.<br />
      <span class="accent">TWO WEEKS.</span>
    </h1>
    <p class="body-text reveal">
      A Cloudflare Workers read layer for slow stock, price and PIM APIs.
    </p>
    <div class="actions reveal">
      <a href="#contact" class="btn" data-offer="audit">BOOK THE AUDIT →</a>
      <a href="#offers" class="link">SEE THE SCOPE ↓</a>
    </div>
  </div>
</section>
