---
import { t, lines, homePath, type Locale } from '../../i18n';
import { STORE_ORIGIN } from '../../lib/storeHost';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const s = t(Astro.currentLocale);
const next = [
  { step: s.build_step, name: s.build_name_h, price: s.build_price, text: s.build_text },
  { step: s.ops_step, name: s.ops_name_h, price: s.ops_price, text: s.ops_text },
];
---

<section class="section section--offers" id="offers">
  <span class="section__meta">{s.offers_meta}</span>

  <div class="section__inner">
    <h2 class="heading-lg reveal">{lines(s.offers_h).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>

    <div class="offer offer--lead reveal">
      <span class="offer__step">{s.audit_step}</span>
      <div class="offer__head">
        <h3 class="offer__name">{lines(s.audit_name_h).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h3>
        <span class="offer__price">{s.audit_price}</span>
      </div>
      <ul class="offer__list">
        <li>{s.audit_li1}</li>
        <li>{s.audit_li2}</li>
        <li>{s.audit_li3}</li>
      </ul>
      <div class="actions">
        <a href="#contact" class="btn btn--dark" data-offer="audit">{s.audit_btn}</a>
        <span class="offer__note">{s.audit_note}</span>
      </div>
    </div>

    <div class="offer-row reveal">
      {next.map((o) => (
        <div class="offer">
          <span class="offer__step">{o.step}</span>
          <div class="offer__head">
            <h3 class="offer__name">{lines(o.name).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h3>
            <span class="offer__price">{o.price}</span>
          </div>
          <p class="offer__text">{o.text}</p>
        </div>
      ))}
    </div>

    <a class="offer offer--fork reveal" href={STORE_ORIGIN + homePath(locale)}>
      <span class="offer__step">{s.offers_fork_step}</span>
      <div class="offer__head">
        <h3 class="offer__name">{s.offers_fork_name}</h3>
      </div>
      <p class="offer__text">{s.offers_fork_text}</p>
      <span class="link">{s.offers_fork_link}</span>
    </a>
  </div>
</section>

<style>
  .offer--fork {
    display: block;
    margin-top: 3rem;
    color: inherit;
  }
  .offer--fork .link {
    display: inline-block;
    margin-top: 1.25rem;
  }
</style>
