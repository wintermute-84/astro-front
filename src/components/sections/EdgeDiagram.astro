<section class="section section--diagram" id="how" aria-label="Before and after: slow origin API versus edge read layer">
  <div class="diagram-wrap reveal">
    <div class="captions" aria-hidden="true">
      <p class="caption scene-a"><span class="caption__tag">Before.</span> Every read waits on the origin.</p>
      <p class="caption scene-b"><span class="caption__tag caption__tag--red">After.</span> Reads served from the edge node nearest the customer.</p>
    </div>

    <svg class="diagram diagram--wide" viewBox="0 48 760 182" role="img" aria-labelledby="diagram-title">
      <title id="diagram-title">
        Before: the frontend waits about 0.8 seconds on a slow PIM or ERP API. After: a global edge network answers from the node nearest each customer in about 45 ms, and the origin refreshes in the background.
      </title>

      <g class="scene-a"><text x="180" y="76" class="timer timer--slow"><tspan class="approx">~</tspan>800 ms</text></g>
      <g class="scene-b"><text x="180" y="76" class="timer timer--fast"><tspan class="approx">~</tspan>45 ms</text></g>

      <!-- customers -->
      <g class="node">
        <line x1="47" y1="95" x2="110" y2="125" />
        <line x1="47" y1="125" x2="110" y2="125" />
        <line x1="47" y1="155" x2="110" y2="125" />
        <circle cx="40" cy="95" r="7" class="dot" />
        <circle cx="40" cy="125" r="7" class="dot" />
        <circle cx="40" cy="155" r="7" class="dot" />
        <text x="40" y="190" class="label">CUSTOMERS</text>
      </g>

      <!-- frontend -->
      <rect x="110" y="92" width="140" height="66" class="box" />
      <text x="180" y="129" class="box__title">FRONTEND</text>
      <rect x="110" y="168" width="140" height="3" class="wait-bar" />

      <!-- origin (dims once the edge takes over) -->
      <g class="origin">
        <line x1="250" y1="125" x2="600" y2="125" class="wire" />
        <rect x="600" y="92" width="140" height="66" class="box" />
        <text x="670" y="124" class="box__title">PIM / ERP</text>
        <text x="670" y="143" class="label">origin API</text>
      </g>

      <!-- global edge network -->
      <g class="edge">
        <circle cx="360" cy="125" r="52" class="globe" />
        <ellipse cx="360" cy="125" rx="52" ry="18" class="globe__line" />
        <ellipse cx="360" cy="125" rx="26" ry="52" class="globe__line globe__meridian" />
        <ellipse cx="360" cy="125" rx="26" ry="52" class="globe__line globe__meridian globe__meridian--late" />
        <circle cx="340" cy="92" r="3" class="pop" />
        <circle cx="384" cy="98" r="3" class="pop" />
        <circle cx="398" cy="134" r="3" class="pop" />
        <circle cx="372" cy="162" r="3" class="pop" />
        <circle cx="336" cy="156" r="3" class="pop" />
        <circle cx="362" cy="122" r="3" class="pop" />
        <circle cx="308" cy="125" r="5" class="pop-near__ring" />
        <circle cx="308" cy="125" r="5" class="pop-near" />
        <text x="360" y="203" class="label label--red">EDGE NETWORK</text>
        <text x="360" y="220" class="label label--small">nearest node server</text>
      </g>

      <!-- packets -->
      <circle cx="256" cy="125" r="5" class="packet packet--slow" />
      <circle cx="256" cy="125" r="5" class="packet packet--fast" />
      <circle cx="416" cy="125" r="3.5" class="packet packet--sync" />
      <text x="508" y="112" class="label label--small sync-label">background refresh</text>
    </svg>

    <svg class="diagram diagram--tall" viewBox="-50 0 365 440" role="img" aria-labelledby="diagram-title-tall">
      <title id="diagram-title-tall">
        Before: the frontend waits about 0.8 seconds on a slow PIM or ERP API. After: a global edge network answers from the node nearest each customer in about 45 ms, and the origin refreshes in the background.
      </title>

      <!-- customers -->
      <g class="node">
        <line x1="90" y1="51" x2="130" y2="80" />
        <line x1="130" y1="51" x2="130" y2="80" />
        <line x1="170" y1="51" x2="130" y2="80" />
        <circle cx="90" cy="44" r="7" class="dot" />
        <circle cx="130" cy="44" r="7" class="dot" />
        <circle cx="170" cy="44" r="7" class="dot" />
        <text x="130" y="18" class="label">CUSTOMERS</text>
      </g>

      <!-- frontend -->
      <rect x="60" y="80" width="140" height="56" class="box" />
      <text x="130" y="112" class="box__title">FRONTEND</text>
      <rect x="60" y="141" width="140" height="3" class="wait-bar" />
      <g class="scene-a"><text x="262" y="114" class="timer timer--slow"><tspan class="approx">~</tspan>800 ms</text></g>
      <g class="scene-b"><text x="262" y="114" class="timer timer--fast"><tspan class="approx">~</tspan>45 ms</text></g>

      <!-- origin -->
      <g class="origin">
        <line x1="130" y1="144" x2="130" y2="370" class="wire" />
        <rect x="60" y="370" width="140" height="56" class="box" />
        <text x="130" y="396" class="box__title">PIM / ERP</text>
        <text x="130" y="414" class="label">origin API</text>
      </g>

      <!-- global edge network; nearest node faces the customers -->
      <g class="edge">
        <circle cx="130" cy="250" r="48" class="globe" />
        <ellipse cx="130" cy="250" rx="48" ry="16" class="globe__line" />
        <ellipse cx="130" cy="250" rx="24" ry="48" class="globe__line globe__meridian" />
        <ellipse cx="130" cy="250" rx="24" ry="48" class="globe__line globe__meridian globe__meridian--late" />
        <circle cx="110" cy="232" r="3" class="pop" />
        <circle cx="154" cy="226" r="3" class="pop" />
        <circle cx="166" cy="258" r="3" class="pop" />
        <circle cx="140" cy="284" r="3" class="pop" />
        <circle cx="104" cy="276" r="3" class="pop" />
        <circle cx="132" cy="252" r="3" class="pop" />
        <circle cx="130" cy="202" r="5" class="pop-near__ring" />
        <circle cx="130" cy="202" r="5" class="pop-near" />
        <text x="255" y="246" class="label label--red">EDGE NETWORK</text>
        <text x="255" y="262" class="label label--small">nearest node server</text>
      </g>

      <!-- packets -->
      <circle cx="130" cy="152" r="5" class="packet packet--slow packet--v" />
      <circle cx="130" cy="152" r="5" class="packet packet--fast packet--v" />
      <circle cx="130" cy="302" r="3.5" class="packet packet--sync packet--v" />
      <text x="255" y="340" class="label label--small sync-label">background refresh</text>
    </svg>
  </div>
</section>

<style>
  .section--diagram {
    min-height: auto;
    background: var(--black);
    color: var(--white);
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .diagram-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
  }

  .captions {
    display: grid;
    text-align: center;
  }

  .caption {
    grid-area: 1 / 1;
    margin: 0;
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.5;
    color: var(--gray);
  }

  .caption__tag { color: var(--white); }
  .caption__tag--red { color: var(--red); }

  .diagram {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1.25rem;
    overflow: visible;
  }

  .diagram--tall { display: none; max-width: 365px; margin-inline: auto; }
  .diagram--tall .timer { font-size: 16px; }

  @media (max-width: 767px) {
    .diagram--wide { display: none; }
    .diagram--tall { display: block; }
  }

  text {
    fill: var(--white);
    text-anchor: middle;
  }

  .timer {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.02em;
  }

  .approx { font-family: var(--font-body); font-weight: 700; }

  .timer--slow { fill: var(--gray); }
  .timer--fast { fill: var(--red); }

  .label {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--gray);
    letter-spacing: 0.04em;
  }

  .label--red { fill: var(--red); }
  .label--small { font-size: 10px; letter-spacing: 0; }

  .box {
    fill: none;
    stroke: var(--white);
    stroke-width: 1.5;
  }

  .box__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 12px;
  }

  .node line,
  .wire {
    stroke: var(--gray-dark);
    stroke-width: 1.5;
  }

  .wire { stroke-dasharray: 4 6; }
  .dot { fill: var(--white); }

  .globe { fill: var(--black); stroke: var(--red); stroke-width: 1.5; }
  .globe__line { fill: none; stroke: var(--red); stroke-width: 1; opacity: 0.45; }
  .pop { fill: var(--red); opacity: 0.75; }
  .pop-near { fill: var(--red); }
  .pop-near__ring { fill: none; stroke: var(--red); stroke-width: 1.5; }

  .wait-bar { fill: var(--gray); transform-box: fill-box; transform-origin: left; }

  .packet--slow { fill: var(--white); }
  .packet--fast { fill: var(--red); }
  .packet--sync { fill: var(--gray); }

  /* Ambient globe motion: meridians sweep to suggest rotation, nearest node pulses. */
  .globe__meridian {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 6s linear infinite;
  }

  .globe__meridian--late { animation-delay: -3s; }

  .pop-near__ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 1.6s ease-out infinite;
  }

  @keyframes spin {
    0% { transform: scaleX(2); }
    50% { transform: scaleX(0.05); }
    100% { transform: scaleX(2); }
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(3); opacity: 0; }
  }

  /* One shared 12s timeline: 0-42% before, 42-50% transition, 50-94% after, 94-100% reset. */
  .scene-a, .scene-b, .origin, .edge, .wait-bar, .packet, .sync-label {
    animation-duration: 12s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .scene-a { animation-name: scene-a; }
  .scene-b { animation-name: scene-b; opacity: 0; }
  .origin { animation-name: origin; }
  .edge { animation-name: edge; opacity: 0; }
  .wait-bar { animation-name: wait-bar; animation-timing-function: linear; }
  .packet--slow { animation-name: packet-slow; animation-timing-function: linear; }
  .packet--fast { animation-name: packet-fast; opacity: 0; }
  .packet--sync { animation-name: packet-sync; animation-timing-function: linear; opacity: 0; }
  .packet--slow.packet--v { animation-name: packet-slow-v; }
  .packet--fast.packet--v { animation-name: packet-fast-v; }
  .packet--sync.packet--v { animation-name: packet-sync-v; }
  .sync-label { animation-name: sync-label; opacity: 0; }

  @keyframes scene-a {
    0%, 40% { opacity: 1; }
    44%, 96% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes scene-b {
    0%, 46% { opacity: 0; }
    50%, 93% { opacity: 1; }
    97%, 100% { opacity: 0; }
  }

  @keyframes origin {
    0%, 42% { opacity: 1; }
    50%, 93% { opacity: 0.35; }
    100% { opacity: 1; }
  }

  @keyframes edge {
    0%, 42% { opacity: 0; transform: translateY(8px); }
    50%, 93% { opacity: 1; transform: translateY(0); }
    98%, 100% { opacity: 0; transform: translateY(8px); }
  }

  @keyframes wait-bar {
    0%, 4% { transform: scaleX(0); opacity: 1; }
    32%, 40% { transform: scaleX(1); opacity: 1; }
    43%, 100% { transform: scaleX(1); opacity: 0; }
  }

  @keyframes packet-slow {
    0%, 4% { transform: translateX(0); opacity: 0; }
    5% { opacity: 1; }
    18% { transform: translateX(339px); }
    31% { transform: translateX(0); opacity: 1; }
    32%, 100% { transform: translateX(0); opacity: 0; }
  }

  @keyframes packet-fast {
    0%, 51% { transform: translateX(0); opacity: 0; }
    52%, 62%, 72% { transform: translateX(0); opacity: 1; }
    53.5%, 63.5%, 73.5% { transform: translateX(42px); }
    55%, 65%, 75% { transform: translateX(0); opacity: 1; }
    76%, 100% { transform: translateX(0); opacity: 0; }
  }

  @keyframes packet-sync {
    0%, 77% { transform: translateX(0); opacity: 0; }
    78% { opacity: 0.9; }
    91% { transform: translateX(181px); opacity: 0.9; }
    92%, 100% { transform: translateX(181px); opacity: 0; }
  }

  @keyframes packet-slow-v {
    0%, 4% { transform: translateY(0); opacity: 0; }
    5% { opacity: 1; }
    18% { transform: translateY(213px); }
    31% { transform: translateY(0); opacity: 1; }
    32%, 100% { transform: translateY(0); opacity: 0; }
  }

  @keyframes packet-fast-v {
    0%, 51% { transform: translateY(0); opacity: 0; }
    52%, 62%, 72% { transform: translateY(0); opacity: 1; }
    53.5%, 63.5%, 73.5% { transform: translateY(40px); }
    55%, 65%, 75% { transform: translateY(0); opacity: 1; }
    76%, 100% { transform: translateY(0); opacity: 0; }
  }

  @keyframes packet-sync-v {
    0%, 77% { transform: translateY(0); opacity: 0; }
    78% { opacity: 0.9; }
    91% { transform: translateY(63px); opacity: 0.9; }
    92%, 100% { transform: translateY(63px); opacity: 0; }
  }

  @keyframes sync-label {
    0%, 77% { opacity: 0; }
    80%, 90% { opacity: 1; }
    93%, 100% { opacity: 0; }
  }

  /* Reduced motion: show the "after" state, no movement. */
  @media (prefers-reduced-motion: reduce) {
    .scene-a, .scene-b, .origin, .edge, .wait-bar, .packet, .sync-label,
    .globe__meridian, .pop-near__ring { animation: none; }
    .scene-a, .wait-bar, .packet { opacity: 0; }
    .scene-b, .edge { opacity: 1; transform: none; }
    .origin { opacity: 0.35; }
  }
</style>
