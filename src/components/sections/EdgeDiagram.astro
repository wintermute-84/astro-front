<script>
  const root = document.getElementById('how');
  const track = root?.querySelector<HTMLElement>('.track');
  const slides = root ? [...root.querySelectorAll<HTMLElement>('.slide')] : [];
  const tabs = root ? [...root.querySelectorAll<HTMLButtonElement>('.tab')] : [];

  if (root && track && slides.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;

    const activate = (i: number) => {
      if (i === current && slides[i].classList.contains('is-active')) return;
      current = i;
      slides.forEach((slide, j) => slide.classList.toggle('is-active', i === j));
      tabs.forEach((tab, j) => {
        tab.setAttribute('aria-selected', String(i === j));
        tab.tabIndex = i === j ? 0 : -1;
      });
      // Start the shown slide from its "before" state.
      slides[i].getAnimations({ subtree: true }).forEach((a) => (a.currentTime = 0));
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    const goTo = (i: number) => {
      track.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
      activate(i);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => goTo(i));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = (i + step + tabs.length) % tabs.length;
        goTo(next);
        tabs[next].focus();
      });
    });

    // Swiping updates the active slide.
    const seen = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && activate(slides.indexOf(e.target as HTMLElement))),
      { root: track, threshold: 0.6 },
    );
    slides.forEach((slide) => seen.observe(slide));

    // Nothing animates while the section is off screen.
    new IntersectionObserver(([e]) => root.classList.toggle('is-paused', !e.isIntersecting)).observe(root);
  }
</script>
