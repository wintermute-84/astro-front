---
import { t, lines } from '../../i18n';

const s = t(Astro.currentLocale);
---

<section class="section section--agency" id="agency">
  <span class="section__meta">{s.agency_meta}</span>

  <div class="section__inner">
    <h2 class="heading-lg reveal">{lines(s.agency_h).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
    <p class="body-text reveal">
      <strong>{s.agency_lead_strong}</strong> {s.agency_lead}
    </p>
    <div class="actions reveal">
      <a href="#contact" class="btn btn--dark" data-offer="agency">{s.agency_btn}</a>
      <span class="offer__note">{s.agency_note}</span>
    </div>
  </div>
</section>
