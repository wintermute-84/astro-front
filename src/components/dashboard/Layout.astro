---
import '../../styles/global.css';
import '../../styles/dashboard.css';
import { RANGES, parseRange } from '../../lib/dashboard/format';
import { rpc } from '../../lib/dashboard/edge';
import Sheet from './Sheet.astro';
import Toast from './Toast.astro';

interface Props {
  title: string;
  /** Breadcrumb trail; last item is the current page. */
  crumbs: { label: string; href?: string }[];
  /** Show the 24H / 7D / 30D control (pages with time series). */
  ranged?: boolean;
}

const { title, crumbs, ranged = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const range = parseRange(Astro.url.searchParams.get('range'));
const list = await rpc((api) => api.listTenants());
const tenants = list.ok ? list.data : [];
const flash = Astro.locals.flash;

const nav = [
  { label: 'Overview', items: [{ label: 'Overview', href: '/dashboard' }] },
  {
    label: 'Tenants',
    items: [
      { label: 'All tenants', href: '/dashboard/tenants' },
      ...tenants.map((t) => ({ label: t.slug, href: `/dashboard/tenants/${t.slug}` })),
    ],
  },
  {
    label: 'Cache',
    items: [
      { label: 'Rules', href: '/dashboard/rules' },
      { label: 'Purge', href: '/dashboard/purge' },
      { label: 'Test request', href: '/dashboard/test' },
    ],
  },
  { label: 'Logs', items: [{ label: 'Purge log', href: '/dashboard/logs/purge' }] },
  { label: 'System', items: [{ label: 'UI kit', href: '/dashboard/ui' }] },
];

function rangeHref(r: string) {
  const u = new URL(Astro.url);
  u.searchParams.set('range', r);
  return u.pathname + u.search;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{title} · 3DreamLab Edge</title>
  </head>
  <body class="dash">
    <div class="shell">
      <nav class="sidebar" aria-label="Dashboard">
        <a href="/dashboard" class="sidebar__logo">3DREAMLAB <span>/ EDGE</span></a>
        {
          nav.map((g) => (
            <div class="sidebar__group">
              <span class="label">{g.label}</span>
              <ul>
                {g.items.map((i) => (
                  <li>
                    <a class="sidebar__item" href={i.href} aria-current={i.href === path ? 'page' : undefined}>
                      {i.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="main">
        <header class="topbar">
          <ol class="crumbs mono" aria-label="Breadcrumb">
            {
              crumbs.map((c, i) =>
                i === crumbs.length - 1 ? (
                  <li aria-current="page">{c.label}</li>
                ) : (
                  <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>
                ),
              )
            }
          </ol>
          <div class="topbar__right">
            {
              ranged && (
                <nav class="segmented mono" aria-label="Time range">
                  {RANGES.map((r) => (
                    <a href={rangeHref(r)} aria-current={r === range ? 'true' : undefined}>
                      {r.toUpperCase()}
                    </a>
                  ))}
                </nav>
              )
            }
            {Astro.locals.user && <span class="topbar__user mono">{Astro.locals.user.email}</span>}
            <button type="button" class="btn" popovertarget="test-request">Test request</button>
          </div>
        </header>

        <main class="content" id="main">
          <slot />
        </main>
      </div>
    </div>

    <Sheet id="test-request" title="Test request">
      <form class="form-grid" method="post" action="/dashboard/test">
        <label class="f">
          <span class="f__label label">Tenant</span>
          <select class="f__input mono" name="slug">
            {tenants.map((t) => <option value={t.slug}>{t.slug}</option>)}
          </select>
        </label>
        <label class="f">
          <span class="f__label label">Method</span>
          <select class="f__input mono" name="method"><option>GET</option><option>POST</option></select>
        </label>
        <label class="f">
          <span class="f__label label">Path</span>
          <input class="f__input mono" name="path" required pattern="/[^?#]*" placeholder="/products" />
          <span class="f__error mono">Path must start with / and have no query</span>
        </label>
        <label class="f">
          <span class="f__label label">Query</span>
          <input class="f__input mono" name="query" placeholder="sku=SKU-1" />
        </label>
        <p class="f__hint mono">Runs through the edge worker with the tenant's live rules. Headers and body: <a class="link" href="/dashboard/test">full form</a>.</p>
        <div><button class="btn">Send</button></div>
      </form>
    </Sheet>
    <slot name="after" />
    {flash && <Toast kind={flash.kind} message={flash.message} dismissHref={Astro.url.pathname + Astro.url.search} />}
  </body>
</html>
