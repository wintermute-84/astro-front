---
import { t } from '../i18n';

const s = t(Astro.currentLocale);
---

<footer class="footer">
  <span>© {new Date().getFullYear()} 3DreamLab · {s.footer_country}</span>
  <span>{s.footer_privacy}</span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 2rem 5vw;
    border-top: 1px solid var(--gray-dark);
    background: var(--black);
    color: var(--gray);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.02em;
  }
</style>
