---
import '../styles/global.css';
import { LOCALES, homePath, t } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  preloadHero?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/HEAD.jpeg', preloadHero = false } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{preloadHero && (
  <link
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset="/LIGHT-640.webp 640w, /LIGHT-960.webp 960w, /LIGHT.webp 1400w"
    imagesizes="100vw"
    fetchpriority="high"
  />
)}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
{LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath(l), Astro.site)} />)}
<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={t(Astro.currentLocale).og_locale} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
