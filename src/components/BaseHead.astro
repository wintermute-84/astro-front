---
import '../styles/global.css';
import { LOCALES, homePath, localePath, stripLocale, t, type Locale } from '../i18n';
import { STORE_ORIGIN } from '../lib/storeHost';

interface Props {
  title: string;
  description: string;
  image?: string;
  preloadHero?: boolean;
  /** Hero image base path; expects -640/-960 .webp variants next to it. */
  hero?: string;
}

const path = stripLocale(Astro.url.pathname);
// The store pages are built under /store/ but served at the root of store.3dreamlab.com.
const onStore = path === '/store/';
const href = (l: Locale | 'x') =>
  onStore ? new URL(homePath(l === 'x' ? 'en' : l), STORE_ORIGIN) : new URL(l === 'x' ? path : localePath(l, path), Astro.site);
const canonicalURL = onStore ? href((Astro.currentLocale ?? 'en') as Locale) : new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/HEAD.jpeg', preloadHero = false, hero = '/LIGHT' } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{preloadHero && (
  <link
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={`${hero}-640.webp 640w, ${hero}-960.webp 960w, ${hero}.webp 1400w`}
    imagesizes="100vw"
    fetchpriority="high"
  />
)}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
{LOCALES.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
<link rel="alternate" hreflang="x-default" href={href('x')} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={t(Astro.currentLocale).og_locale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
